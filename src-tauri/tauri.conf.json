{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Saywell",
  "version": "0.1.0",
  "identifier": "app.saywell.dictation",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": [
      "binaries/whisper/*",
      "binaries/llama/llama-server.exe",
      "binaries/llama/llama-server-impl.dll",
      "binaries/llama/llama.dll",
      "binaries/llama/llama-common.dll",
      "binaries/llama/mtmd.dll",
      "binaries/llama/ggml.dll",
      "binaries/llama/ggml-base.dll",
      "binaries/llama/ggml-vulkan.dll",
      "binaries/llama/ggml-cpu-*.dll",
      "binaries/llama/libomp.dll",
      "binaries/llama/LICENSE-LLVM-OpenMP",
      "THIRD_PARTY_NOTICES.md"
    ],
    "publisher": "Saywell",
    "copyright": "Saywell contributors",
    "category": "Productivity",
    "shortDescription": "Private, offline voice dictation for Windows",
    "longDescription": "Hold a key, speak, and Saywell types your words into any app. Speech recognition and text cleanup run entirely on this PC.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": false
      }
    }
  }
}
